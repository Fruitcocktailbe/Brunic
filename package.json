{
  "name": "brunic",
  "version": "0.0.0",
  "private": true,
  "description": "Brunic webshop — headless Shopify storefront + catalogus-pipeline",
  "scripts": {
    "dev": "pnpm --filter @brunic/web dev",
    "build": "pnpm --filter @brunic/web build",
    "start": "pnpm --filter @brunic/web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:prototype": "pnpm --filter @brunic/prototype dev",
    "build:prototype": "pnpm --filter @brunic/prototype build",
    "winkel": "node packages/catalog/toon-winkel.mjs",
    "prototype:sync": "node apps/prototype/scripts/sync-shopify.mjs"
  }
}
