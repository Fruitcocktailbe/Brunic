# Kopieer naar .env (gitignored) en vul in. Tokens aanmaken: zie docs/bouwstart.md §2.
# Klant-account-credentials (IG e.d.) horen NIET hier maar in J.A.R.V.I.S clients/brunic/.env.client.

# Shopify dev-store (Partner-account van HackersQuattro)
SHOPIFY_STORE_DOMAIN=brunic-3.myshopify.com
# Storefront API — uit de Headless-app (Sales channel), public token volstaat voor de site
SHOPIFY_STOREFRONT_API_TOKEN=
# Admin API access token — custom app "brunic-catalog-pipeline" (Settings > Apps > Develop apps,
# NIET via het Partner Dashboard). Begint met shpat_ , pas zichtbaar na "Install app".
# Scopes: read_products, write_products, write_files, write_publications
#   (write_publications is nodig: productSet publiceert niet vanzelf op het Headless-kanaal)
SHOPIFY_ADMIN_API_TOKEN=

# App-credentials van diezelfde custom app (tab "API credentials"). NIET de access token.
# SHOPIFY_API_SECRET (shpss_...) verifieert de HMAC van Shopify-webhooks (/api/webhooks/shopify).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Storefront API-versie (pin bewust; upgraden = expliciete actie)
SHOPIFY_API_VERSION=2025-10

# Opmeting-lead notificatie loopt via Shopify Flow (Customer updated → tag 'opmeting-nieuw'
# → Send internal email → Remove tag). Geen externe mailprovider / env-var nodig.

# Chatbot (pas nodig bij chatbot-bouw; spend-cap instellen op console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Webshop-site (apps/prototype) ─────────────────────────────────────────
# Admin-toegang voor de formulieren (klantfiche + foto's) als er geen SHOPIFY_ADMIN_API_TOKEN is:
# Dev Dashboard-app via client credentials. Scopes: read_customers, write_customers, write_files.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Publieke URL (canonical, sitemap, Open Graph). Productie: https://www.brunic.be
SITE_URL=https://www.brunic.be
# Enkel op de productieomgeving op 1 zetten; anders noindex + robots "disallow" (previews!).
SITE_INDEXEREN=
# Ondernemingsnummer (standaard BE 0446.774.674 uit brunic.be/contact); enkel invullen om te overschrijven.
SITE_COMPANY_NUMBER=
# 1 = formulieren loggen in de console i.p.v. een Shopify-klant aan te maken (lokaal/preview).
LEADS_DRYRUN=1
